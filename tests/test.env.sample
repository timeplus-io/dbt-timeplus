## Sample env for functional tests
# Copy to tests/test.env and adjust as needed.

# Core dbt profile (Timeplus)
# DBT_TEST_HOST=localhost
# DBT_TEST_PORT=8463
# DBT_TEST_USER=default
# DBT_TEST_PASSWORD=
# DBT_TEST_SCHEMA=default

# External ClickHouse sink (optional)
# CH_ADDRESS=clickhouse:9440
# CH_DATABASE=default
# CH_TABLE=ch_sink_table
# CH_USER=default
# CH_PASSWORD=
# CH_SECURE=false
# CH_CA_CERT=

# External Kafka sink (optional)
# KAFKA_BROKERS=broker:9092
# KAFKA_TOPIC=test_topic

